# Frontend environment template — COPY to `.env` or `.env.local` and fill in.
# Only browser-safe values belong here. Never put secrets, service-role keys,
# R2 access keys, or JWT secrets in a VITE_* variable (or in any frontend file):
# anything prefixed with VITE_ is published into the client bundle.

# Supabase project — dashboard: Project Settings → API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Cloudflare Worker origin (the one deployed from the `worker/` directory)
VITE_WORKER_URL="https://your-worker-name.your-subdomain.workers.dev"
