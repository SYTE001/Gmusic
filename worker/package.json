{
  "name": "local-music-r2-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker issuing authenticated, short-lived presigned R2 URLs for Local Music.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "esbuild": "^0.28.2",
    "miniflare": "^3.20250410.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0",
    "wrangler": "^3.114.17"
  }
}
